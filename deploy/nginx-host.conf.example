# Zap Komunick: site for the server's own nginx, in front of the app on
# 127.0.0.1:5480 (ZK_HTTP_PORT) for superchat.komunick.com. Save it as
# /etc/nginx/sites-available/zap-komunick, enable it and get the certificate:
#   sudo ln -s /etc/nginx/sites-available/zap-komunick /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d superchat.komunick.com

server {
    listen 80;
    server_name superchat.komunick.com;

    # attachments and voice notes
    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:5480;
        proxy_http_version 1.1;

        # Socket.IO (realtime) needs the upgrade headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 120s;
    }
}
