# Zap Komunick: variables of docker-compose-komunick.yaml.
# Copy to ".env" in the repository root and fill in (docs/DEPLOY.md).

# Database password: long and random, e.g. the output of
#   openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_USER=ticketz
POSTGRES_DB=ticketz

# Local port where the app answers (127.0.0.1 only); the server's nginx points here
ZK_HTTP_PORT=5480

# Tag of the images built on this server (e.g. the commit or the date)
ZK_VERSION=local

TZ=America/Sao_Paulo
