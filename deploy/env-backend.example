# Zap Komunick: backend environment. Copy to ".env-backend-komunick" in the
# repository root (docs/DEPLOY.md). Never commit the filled-in file.

# Address of the installation (the same in the frontend file)
FRONTEND_HOST=superchat.komunick.com
# E-mail of the first administrator (created on the first start)
EMAIL_ADDRESS=contato@komunick.com
# Password of the first administrator. Change it again after the first login.
ADMIN_PASSWORD=
TZ=America/Sao_Paulo

# Usually unchanged from here on

BACKEND_PATH=/backend
BACKEND_URL=https://${FRONTEND_HOST}${BACKEND_PATH}
FRONTEND_URL=https://${FRONTEND_HOST}

DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=ticketz
DB_NAME=ticketz
DB_TIMEZONE=-03:00
# DB_PASS comes from POSTGRES_PASSWORD in ".env"

REDIS_URI=redis://redis:6379
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true

# Socket.IO admin panel: off in production
SOCKET_ADMIN=false

RECAPTCHA_SECRET_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Token of the Meta webhooks (only with official channels): random value
VERIFY_TOKEN=

# Backend-only encryption key: 32 random bytes encoded as base64. Keep a secure
# backup separately from the database. Never put this value in frontend config.
CREDENTIALS_MASTER_KEY=
# Only during a controlled master-key rotation; remove after re-encryption.
CREDENTIALS_PREVIOUS_MASTER_KEY=

# P1 remains off by default. "mock" enables the local simulation only and also
# requires the company's administrator to enable it in Settings.
AI_ASSISTANT_MODE=disabled

# P2: "mock" is local simulation only; also requires the company's admin flag.
ACESSORIAS_MODE=disabled

# P3 SCI and P4 integrated queries are simulations with independent company flags.
SCI_MODE=disabled
INTEGRATED_ASSISTANT_MODE=disabled
