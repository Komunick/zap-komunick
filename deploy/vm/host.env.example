# Copie para $ZAPK_ROOT/host.env na VM de destino. Nao contem segredo.
# Saida de `hostname -s`. Os scripts se recusam a rodar em outra VM.
ZAPK_HOST=
# traefik (Traefik ja existente, como o do Coolify) ou caddy (Caddy no host)
ZAPK_INGRESS=traefik
# So com traefik: rede Docker do proxy e a faixa dela (docker network inspect)
ZAPK_INGRESS_NETWORK=coolify
ZAPK_TRUSTED_CIDR=
